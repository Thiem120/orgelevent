{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orgelevent",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "orgelevent.nl", "custom_domain": true },
    { "pattern": "www.orgelevent.nl", "custom_domain": true }
  ]
}
